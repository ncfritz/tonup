{
  "name": "tonup-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Ton Up Lab: training data, runs and models for snap to score (ADR 0012)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "dev:lan": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "start:lan": "next start -H 0.0.0.0 -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.7.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
