{
  "name": "tonup",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "ios:sync": "expo prebuild --platform ios --clean",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/check-contrast.mjs",
    "doctor": "expo-doctor",
    "prepare": "simple-git-hooks",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.16",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-iap": "6.3.0",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "26.5.4",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "react": "19.3.0",
    "react-i18next": "17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "3.6.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
